{
    "layer": "top", 
    "position": "top", 
    "modules-left": ["custom/main", "custom/music"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/mic", "pulseaudio", "clock", "tray", "custom/lock"],
    "hyprland/workspaces": {
         "disable-scroll": true,
         "sort-by-number": true,
         "format": "{icon}",
         "format-icons": {
            "1": "󰈹",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "10": "",
            "default": ""
         },
        // Bind per output. The "*": 5 wildcard numbered persistent workspaces
        // across BOTH monitors, so the main bar got slots 6-9 with no
        // format-icons entry and fell back to the "default" dot.
        "persistent-workspaces": {
            "DP-3": [1, 2, 3, 4, 5],
            "HDMI-A-1": [10],
        },
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "custom/main": {
        "format": "󰣇",
        "on-click": "walker"
    },
    "custom/music": {
        "format": "  {}",
        "escape": true,
        "interval": 5,
        "tooltip": false,
        "exec": "playerctl --player=spotify,%any metadata --format='{{ title }}'",
        "on-click": "playerctl --player=spotify,%any play-pause",
        "max-length": 50
    },
    "clock": {
        "timezone": "Europe/Paris",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%d/%m/%Y}",
        "format": " {:%H:%M}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        },
        "on-click": "pavucontrol"
    },
    "custom/mic": {
        "exec": "~/.local/bin/mic-status",
        "return-type": "json",
        // mic-toggle no longer signals waybar (dotfiles ff21b8d), so poll instead.
        "interval": 2,
        "on-click": "~/.local/bin/mic-toggle",
        "tooltip": true
    },
    "custom/lock": {
        "tooltip": false,
        "on-click": "walker -m menus:powermenu",
        "format": "󰐥"
    }
}
